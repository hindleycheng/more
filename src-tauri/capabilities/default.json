{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "More 默认权限集：不含 shell / opener，前端只能调用显式注册的 IPC 命令与文件对话框",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "dialog:allow-open",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
