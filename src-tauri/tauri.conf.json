{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "More",
  "version": "0.1.1",
  "identifier": "com.more.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "猫窝 More",
        "width": 1240,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "猫窝 More · WorkBuddy 账号后勤",
    "longDescription": "多账号管理、批量打卡、猫猫旅行托管、俸禄流水与本地 OpenAI 兼容反代。基于 WorkMami(MIT) 改造的第三方独立工具。"
  },
  "plugins": {}
}